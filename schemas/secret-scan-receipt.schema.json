{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.johan-sdd.dev/secret-scan-receipt/v1",
  "title": "Secret-shaped material scan receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "completed_at", "subject", "ruleset", "scanned_inputs", "status", "findings"],
  "properties": {
    "schema_version": { "const": "johan-sdd/secret-scan-receipt/v1" },
    "receipt_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "completed_at": { "type": "string", "format": "date-time" },
    "subject": { "$ref": "#/$defs/hashedRef" },
    "ruleset": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/portableRef" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "scanned_inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hashedRef" } },
    "status": { "enum": ["passed", "findings", "error"] },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "diagnostic_ref": { "$ref": "#/$defs/hashedRef" }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "passed" } }, "required": ["status"] }, "then": { "properties": { "findings": { "maxItems": 0 } } } },
    { "if": { "properties": { "status": { "const": "findings" } }, "required": ["status"] }, "then": { "properties": { "findings": { "minItems": 1 } } } },
    { "if": { "properties": { "status": { "const": "error" } }, "required": ["status"] }, "then": { "required": ["diagnostic_ref"] } }
  ],
  "$defs": {
    "portableRef": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9][A-Za-z0-9._:/@+=-]*$" },
    "hashedRef": {
      "type": "object", "additionalProperties": false, "required": ["ref", "sha256"],
      "properties": { "ref": { "$ref": "#/$defs/portableRef" }, "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
    },
    "finding": {
      "type": "object", "additionalProperties": false, "required": ["rule_id", "fingerprint", "severity", "location_ref"],
      "properties": {
        "rule_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
        "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "severity": { "enum": ["suspicious", "high"] },
        "location_ref": { "$ref": "#/$defs/portableRef" }
      }
    }
  }
}
