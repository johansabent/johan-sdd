{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.johan-sdd.dev/preview/v1",
  "title": "Content-addressed desired-state preview",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "preview_id",
    "desired_state_sha256",
    "target_id",
    "measured_prestate_sha256",
    "trust_root_sha256",
    "allowlist_sha256",
    "operations",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": { "const": "johan-sdd/preview/v1" },
    "preview_id": { "type": "string", "pattern": "^preview_[0-9a-f]{64}$" },
    "desired_state_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "target_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "measured_prestate_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "trust_root_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "allowlist_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "action"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "action": { "enum": ["create", "replace", "remove"] },
        "content_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "enum": ["create", "replace"] } }, "required": ["action"] },
          "then": { "required": ["content_ref"] }
        },
        {
          "if": { "properties": { "action": { "const": "remove" } }, "required": ["action"] },
          "then": { "not": { "required": ["content_ref"] } }
        }
      ]
    }
  }
}
