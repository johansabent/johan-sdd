{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.johan-sdd.dev/cli-invocation/v1",
  "title": "Portable CLI invocation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "invocation_id", "argv", "command", "input_refs", "output", "exit_codes"],
  "properties": {
    "schema_version": { "const": "johan-sdd/cli-invocation/v1" },
    "invocation_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "argv": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 },
      "prefixItems": [{ "const": "johan-sdd" }]
    },
    "command": { "enum": ["select-profile", "route"] },
    "input_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hashedRef" } },
    "output": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["format", "media_type", "schema_ref"],
          "properties": {
            "format": { "const": "json" },
            "media_type": { "const": "application/json" },
            "schema_ref": { "$ref": "#/$defs/portableRef" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["format", "media_type"],
          "properties": {
            "format": { "const": "text" },
            "media_type": { "const": "text/plain" }
          }
        }
      ]
    },
    "exit_codes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "validation_error", "policy_blocked", "operational_failure"],
      "properties": {
        "success": { "const": 0 },
        "validation_error": { "const": 2 },
        "policy_blocked": { "const": 3 },
        "operational_failure": { "const": 4 }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "command": { "const": "select-profile" } }, "required": ["command"] }, "then": { "properties": { "argv": { "prefixItems": [{ "const": "johan-sdd" }, { "const": "select-profile" }] } } } },
    { "if": { "properties": { "command": { "const": "route" } }, "required": ["command"] }, "then": { "properties": { "argv": { "prefixItems": [{ "const": "johan-sdd" }, { "const": "route" }] } } } }
  ],
  "$defs": {
    "portableRef": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9][A-Za-z0-9._:/@+=-]*$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "hashedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": { "ref": { "$ref": "#/$defs/portableRef" }, "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
    }
  }
}
