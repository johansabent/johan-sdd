{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.johan-sdd.dev/apply-receipt/v1",
  "title": "Desired-state application receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "preview_sha256",
    "desired_state_sha256",
    "target_id",
    "measured_prestate_sha256",
    "operations",
    "preview_expires_at",
    "applied_at",
    "actor_policy",
    "readback",
    "rollback"
  ],
  "properties": {
    "schema_version": { "const": "johan-sdd/apply-receipt/v1" },
    "receipt_id": { "type": "string", "pattern": "^apply_[0-9a-f]{64}$" },
    "preview_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "desired_state_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "target_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "measured_prestate_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    },
    "preview_expires_at": { "type": "string", "format": "date-time" },
    "applied_at": { "type": "string", "format": "date-time" },
    "actor_policy": { "$ref": "#/$defs/actorPolicy" },
    "readback": { "$ref": "#/$defs/readback" },
    "rollback": { "$ref": "#/$defs/rollback" }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "action"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "action": { "enum": ["create", "replace", "remove"] },
        "content_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "enum": ["create", "replace"] } }, "required": ["action"] },
          "then": { "required": ["content_ref"] }
        },
        {
          "if": { "properties": { "action": { "const": "remove" } }, "required": ["action"] },
          "then": { "not": { "required": ["content_ref"] } }
        }
      ]
    },
    "actorPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "policy_id", "policy_revision", "policy_sha256"],
      "properties": {
        "actor_id": { "type": "string", "minLength": 1 },
        "policy_id": { "type": "string", "minLength": 1 },
        "policy_revision": { "type": "integer", "minimum": 1 },
        "policy_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "readback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["poststate_sha256", "operations"],
      "properties": {
        "poststate_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "result"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "result": { "enum": ["created", "replaced", "removed"] },
              "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            },
            "allOf": [
              {
                "if": { "properties": { "result": { "const": "removed" } }, "required": ["result"] },
                "then": { "not": { "required": ["content_sha256"] } },
                "else": { "required": ["content_sha256"] }
              }
            ]
          }
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["not-required", "completed", "failed"] },
        "receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "not-required" } }, "required": ["status"] },
          "then": { "not": { "required": ["receipt_sha256"] } },
          "else": { "required": ["receipt_sha256"] }
        }
      ]
    }
  }
}
